    <ProjectGuid>{F6DF0229-C237-4DED-9628-BC08D275DD3F}</ProjectGuid>
    <avrdevice>AVR32DB28</avrdevice>
    <avrdeviceseries>none</avrdeviceseries>
    <OutputType>Executable</OutputType>
